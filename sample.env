# AnonXMusic (C++ port) — environment configuration.
# Copy to ".env" and fill in. Real environment variables override these.

# ---- required ----

# from my.telegram.org/apps
API_ID=
API_HASH=

# from @BotFather
BOT_TOKEN=
LOGGER_ID=

OWNER_ID=

# assistant userbot session (from a string-session generator)
SESSION=

# Phone number of the SESSION account above, in international form (+911234…).
#
# WHY BOTH: this port uses TDLib, which cannot import a Pyrogram/kurigram SESSION
# string — the two session formats are unrelated. SESSION stays the switch that
# says "this assistant slot is configured" (exactly as in the Python config.py),
# and PHONE_NUMBER is what the login actually uses: on first run TDLib asks for
# the login code (and the 2FA password, if set) on stdin, then stores its own
# session under tdlib/assistant1 and never asks again.
# Without it the bot still starts and every non-voice command works, but no voice
# chat can be joined.
PHONE_NUMBER=

# ---- optional: extra assistants (more parallel voice chats) ----
SESSION2=
SESSION3=
PHONE_NUMBER2=
PHONE_NUMBER3=

# ---- storage (replaces MONGO_URL from the Python version) ----
# Path to the SQLite database file. Backed up out-of-process via Litestream.
DB_PATH=anonx.db
